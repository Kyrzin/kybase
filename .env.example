# Copy to .env (for docker compose) or .env.local (for npm run dev).

# Required — auth secret for the UI, API, and MCP endpoint.
# Generate one: openssl rand -hex 32
KYBASE_SECRET=

# Extra callback URIs allowed for the OAuth flow, comma-separated and matched
# in full — not by host, so include the whole URL. claude.ai's connector
# callback and any loopback address are always allowed. Only needed if you're
# connecting an MCP client that does its own hosted OAuth flow instead of a
# static Bearer token.
# KYBASE_OAUTH_REDIRECT_URIS=https://example.com/oauth/callback

# ── docker compose ──────────────────────────────────────────
# Required — the database is only reachable inside the compose network, but
# compose refuses to start without this set (no silent weak default).
# Generate one: openssl rand -hex 16
POSTGRES_PASSWORD=
KYBASE_PORT=3000
# Prebuilt image tag from ghcr.io/kyrzin/kybase. latest tracks the newest
# release; pin to a specific version (e.g. v1.3.0) for deliberate upgrades.
KYBASE_TAG=latest

# ── local dev (npm run dev) ─────────────────────────────────
# Direct Postgres connection; in compose it is derived automatically.
# DATABASE_URL=postgres://kybase:kybase@localhost:5432/kybase

# ── embeddings ──────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=embeddinggemma

# Google alternative (free tier)
# EMBEDDING_PROVIDER=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=text-embedding-004

# OpenAI alternative
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# ── reranking (optional, off by default) ────────────────────
# A cross-encoder reads the query together with each candidate passage and
# reorders the results search already found. It changes ORDER only: it cannot
# surface a note retrieval missed.
#
# Start the service first:  docker compose --profile rerank up -d
# then set the URL below and restart the app. Leave it empty and nothing
# changes — search behaves exactly as it does without this section.
#
# Cost is real and paid on every search: one full model pass per passage.
# On CPU that is hundreds of milliseconds EACH, so TOP_N x PASSAGES_PER_NOTE
# is a latency budget, not a quality dial. Start small and raise it only if
# the reordering is actually better on your own notes.
# KYBASE_RERANK_URL=http://reranker:80
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# How many of the found notes get rescored (default 10, max 50).
# KYBASE_RERANK_TOP_N=10
# Passages per note (default 2, max 5). More passages means a better chance
# the one holding the answer is among them, at a model pass each.
# KYBASE_RERANK_PASSAGES_PER_NOTE=2
# Give up after this and keep the ordinary order (default 20000).
# KYBASE_RERANK_TIMEOUT_MS=20000
