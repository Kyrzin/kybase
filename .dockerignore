.git
.next
node_modules
npm-debug.log*
.env
.env.local
.env*.local
docs
README.md
# README artwork is served by GitHub, never by the running app — the plain
# `node_modules` line above only matches the root one, so name these too.
public/readme
packages
# The private test suite. This block must mirror the testing block in
# .gitignore: anything kept out of the repo is by definition absent from CI
# and present only in a developer working copy, so a build there picks it up
# and typechecks it against devDependencies the image does not install.
# Half-mirroring these two blocks breaks the image build.
**/*.test.ts
lib/__itest__
vitest.config.ts
vitest.integration.config.ts
/coverage
